# Port the server listens on.
PORT=3000

# Public URL of the site (no trailing slash). The OAuth redirect is PUBLIC_URL/auth/callback.
# In local dev, this is the Vite dev server.
PUBLIC_URL=http://localhost:5173

# SQLite file.
DB_PATH=./data/clipq.db

# Kick app credentials from https://kick.com/settings/developer
# Redirect URL to register there: PUBLIC_URL/auth/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Kick chat websocket (Pusher). Change only if Kick rotates the key.
PUSHER_KEY=34bf7a0ff419a2a775b9
PUSHER_CLUSTER=us2

# Local dev only: lets you log in as any channel without OAuth at /auth/dev?slug=<channel>.
# NEVER enable this on a public server.
DEV_LOGIN=0
