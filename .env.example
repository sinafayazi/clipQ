# Port the server listens on.
PORT=3000

# Server deploys only (docker compose): the domain Caddy gets an HTTPS certificate for.
# DOMAIN=clipq.example.com

# Public URL of the site (no trailing slash). The OAuth redirect is PUBLIC_URL/auth/callback.
# In local dev, this is the Vite dev server. On a server: https://<DOMAIN>
PUBLIC_URL=http://localhost:5173

# SQLite file.
DB_PATH=./data/clipq.db

# Kick app credentials from https://kick.com/settings/developer
# Redirect URL to register there: PUBLIC_URL/auth/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional: keep a copy of the database in Turso (https://turso.tech). Needed on hosts whose disk is
# wiped on restart (Render free). Leave empty to use only the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Google Search Console ownership check (URL-prefix property, "HTML tag" method).
# Paste the content="..." value, or the whole google-site-verification=... string.
GOOGLE_SITE_VERIFICATION=

# Kick chat websocket (Pusher). Change only if Kick rotates the key.
PUSHER_KEY=34bf7a0ff419a2a775b9
PUSHER_CLUSTER=us2

# Local dev only: lets you log in as any channel without OAuth at /auth/dev?slug=<channel>.
# NEVER enable this on a public server.
DEV_LOGIN=0
